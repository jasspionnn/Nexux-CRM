
{
  "name": "nexus-crm",
  "version": "1.0.0",
  "description": "A fully customizable CRM with multiple pipelines, Kanban boards, team management, and AI-powered lead insights.",
  "type": "module",
  "main": "index.tsx",
  "scripts": {
    "dev": "vite",
    "backend": "wrangler pages dev dist --port 8787 --d1=DB",
    "backend:remote": "wrangler pages dev dist --port 8787 --d1=DB --remote",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:setup": "wrangler d1 execute nexus-db --local --file=schema.sql",
    "db:prod": "wrangler d1 execute nexus-db --remote --file=schema.sql",
    "db:seed:local": "wrangler d1 execute nexus-db --local --file=seed.sql",
    "db:seed:prod": "wrangler d1 execute nexus-db --remote --file=seed.sql",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "hono": "^4.0.8",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "wrangler": "^3.28.0"
  }
}
