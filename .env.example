# Gemini API Key (Required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Wrangler Configuration
# Get these from your Cloudflare dashboard
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

# Secret used to sign the admin session cookie (functions/api/[[route]].ts).
# Required for the Nexus platform-admin routes (/api/admin/*) to work at all —
# without it they respond 500 by design (fail closed) instead of being open.
# Generate one with: openssl rand -base64 32
# Local dev: copy this line (with a real value) into a .dev.vars file (gitignored).
# Production: wrangler secret put SESSION_SECRET
SESSION_SECRET=
